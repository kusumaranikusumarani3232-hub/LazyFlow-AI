BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_DEFAULT_PROVIDER=openrouter
BACKBOARD_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
# Comma-separated list of allowed origins (e.g., https://lazyflow-ai.vercel.app,http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://lazyflow-ai.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/([a-zA-Z0-9_-]+\.)*vercel\.app$
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=30
SESSION_EXPIRY_MINUTES=60

