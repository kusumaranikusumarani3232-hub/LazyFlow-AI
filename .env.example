# LazyFlow AI Environment Variables Template
# Copy this file to backend/.env and provide your valid credentials.

# 1. Backboard AI Credentials
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_DEFAULT_PROVIDER=openrouter
BACKBOARD_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct

# 2. Server Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=30
SESSION_EXPIRY_MINUTES=60
